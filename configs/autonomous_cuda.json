{
  "name": "aassr_v2_autonomous_cuda",
  "runner": "autonomous_main",
  "output_dir": "runs/autonomous_cuda",
  "seeds": [7, 13, 21, 42, 100],
  "train_episodes": 1000,
  "eval_episodes": 100,
  "evaluation_modes": ["seen", "unseen"],
  "execution": {
    "workers": 0,
    "cuda_workers": 1,
    "device": "cuda",
    "allow_cpu_fallback": false
  },
  "progress": {
    "every_episodes": 50,
    "every_seconds": 5
  },
  "environments": [
    {
      "name": "opaque_dependency_l4",
      "length": 4,
      "seed_offset": 4000,
      "eval_seed_offset": 4004000,
      "train_worlds_per_seed": 8,
      "eval_worlds_per_seed": 32
    },
    {
      "name": "opaque_dependency_l6",
      "length": 6,
      "seed_offset": 6000,
      "eval_seed_offset": 6006000,
      "train_worlds_per_seed": 8,
      "eval_worlds_per_seed": 32
    }
  ],
  "conditions": [
    {
      "name": "tabular_full",
      "model": "tabular",
      "learn_policy": true,
      "learn_prophecy": true,
      "use_imagination": true,
      "validated_gain_weight": 0.2,
      "imagination_interval": 2
    },
    {
      "name": "cuda_gru_no_imagination",
      "model": "torch_gru",
      "device": "cuda",
      "learn_policy": true,
      "learn_prophecy": true,
      "use_imagination": false,
      "validated_gain_weight": 0.2,
      "model_options": {
        "hidden_size": 64,
        "action_feature_size": 32,
        "learning_rate": 0.001,
        "replay_limit": 2048
      }
    },
    {
      "name": "cuda_gru_full",
      "model": "torch_gru",
      "device": "cuda",
      "learn_policy": true,
      "learn_prophecy": true,
      "use_imagination": true,
      "validated_gain_weight": 0.2,
      "imagination_interval": 2,
      "model_options": {
        "hidden_size": 64,
        "action_feature_size": 32,
        "learning_rate": 0.001,
        "replay_limit": 2048
      }
    }
  ]
}
