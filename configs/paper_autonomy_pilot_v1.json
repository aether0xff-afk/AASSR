{
  "schema_version": 1,
  "name": "paper_autonomy_pilot_v1",
  "runner": "paper_suite",
  "protocol_version": "paper-autonomy-pilot-v1",
  "study_stage": "pilot",
  "output_dir": "paper_results/paper-autonomy-pilot-v1",
  "research_seeds": [7, 13, 21, 42, 100],
  "world_seeds": {
    "train": [41001, 41002, 41003, 41004],
    "seen": [41101, 41102],
    "unseen": [91001, 91002, 91003, 91004]
  },
  "budgets": {
    "train_episodes": 100,
    "eval_episodes": 20,
    "real_transitions_per_episode": 8,
    "adaptation_episodes": [0, 1, 4, 16, 64]
  },
  "phases": [
    "training",
    "evaluation_seen",
    "evaluation_unseen_zero_shot",
    "adaptation",
    "evaluation_unseen_adaptation"
  ],
  "phase_learning": {
    "training": true,
    "evaluation_seen": false,
    "evaluation_unseen_zero_shot": false,
    "adaptation": true,
    "evaluation_unseen_adaptation": false
  },
  "statistics": {
    "unit": "research_seed",
    "confidence": 0.95,
    "bootstrap_samples": 5000,
    "permutation_samples": 20000,
    "test": "paired_permutation",
    "multiple_comparisons": "holm"
  },
  "execution": {
    "workers": 1,
    "cuda_workers": 1,
    "device": "cpu",
    "allow_cpu_fallback": true
  },
  "suites": [
    {
      "kind": "autonomy",
      "lengths": [4, 6, 8],
      "conditions": [
        {"name": "random", "real_transition_budget": 800},
        {"name": "contextual_policy", "real_transition_budget": 800},
        {"name": "q_learning", "real_transition_budget": 800},
        {"name": "dqn", "real_transition_budget": 800},
        {"name": "prophecy_no_imagination", "real_transition_budget": 800},
        {"name": "full_aassr", "real_transition_budget": 800},
        {"name": "oracle_upper_bound", "real_transition_budget": 800}
      ]
    }
  ]
}
