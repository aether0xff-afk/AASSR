{
  "schema_version": 1,
  "name": "paper_ablation_pilot_v1",
  "runner": "paper_suite",
  "protocol_version": "paper-ablation-pilot-v1",
  "study_stage": "pilot",
  "output_dir": "paper_results/paper-ablation-pilot-v1",
  "research_seeds": [7, 13, 21, 42, 100],
  "world_seeds": {
    "train": [42001, 42002, 42003, 42004],
    "seen": [42101, 42102],
    "unseen": [92001, 92002, 92003, 92004]
  },
  "budgets": {
    "train_episodes": 64,
    "eval_episodes": 10,
    "real_transitions_per_episode": 6,
    "adaptation_episodes": [0, 1, 4, 16, 64]
  },
  "phases": [
    "training",
    "evaluation_seen",
    "evaluation_unseen_zero_shot",
    "adaptation",
    "evaluation_unseen_adaptation"
  ],
  "phase_learning": {
    "training": true,
    "evaluation_seen": false,
    "evaluation_unseen_zero_shot": false,
    "adaptation": true,
    "evaluation_unseen_adaptation": false
  },
  "statistics": {
    "unit": "research_seed",
    "confidence": 0.95,
    "bootstrap_samples": 5000,
    "permutation_samples": 20000,
    "test": "paired_permutation",
    "multiple_comparisons": "holm"
  },
  "execution": {
    "workers": 1,
    "cuda_workers": 1,
    "device": "cpu",
    "allow_cpu_fallback": true
  },
  "suites": [
    {
      "kind": "ablation",
      "lengths": [6],
      "conditions": [
        {"name": "contextual_policy", "real_transition_budget": 384},
        {"name": "prophecy_no_imagination", "real_transition_budget": 384},
        {"name": "imagination_no_validated_value", "algorithm": "aassr", "validated_gain_weight": 0.0, "real_transition_budget": 384},
        {"name": "full_aassr", "real_transition_budget": 384},
        {"name": "full_no_repeat_penalty", "algorithm": "aassr", "repeat_penalty": 0.0, "real_transition_budget": 384},
        {"name": "full_no_error_penalty", "algorithm": "aassr", "error_penalty": 0.0, "real_transition_budget": 384},
        {"name": "full_no_validated_information", "algorithm": "aassr", "validated_gain_weight": 0.0, "real_transition_budget": 384}
      ],
      "condition_matrix": {
        "base": {
          "algorithm": "aassr",
          "real_transition_budget": 384
        },
        "axes": {
          "imagination_depth": [1, 2, 4, 6],
          "imagination_branching_factor": [1, 2, 4],
          "imagination_aggregation": ["max", "mean", "risk-adjusted"]
        },
        "name_template": "full_depth{imagination_depth}_branch{imagination_branching_factor}_{imagination_aggregation}"
      }
    }
  ]
}
