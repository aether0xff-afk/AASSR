{
  "schema_version": 1,
  "name": "paper_creativity_pilot_v1",
  "runner": "paper_suite",
  "protocol_version": "paper-creativity-pilot-v1",
  "study_stage": "pilot",
  "output_dir": "paper_results/paper-creativity-pilot-v1",
  "research_seeds": [7, 13, 21, 42, 100],
  "world_seeds": {
    "train": [44001, 44002, 44003, 44004],
    "seen": [44101, 44102],
    "unseen": [94001, 94002, 94003, 94004]
  },
  "budgets": {
    "train_episodes": 20,
    "eval_episodes": 10,
    "real_transitions_per_episode": 16,
    "adaptation_episodes": [0, 1, 4, 16, 64]
  },
  "phases": ["training", "evaluation_seen", "evaluation_unseen_zero_shot", "adaptation", "evaluation_unseen_adaptation"],
  "phase_learning": {
    "training": true,
    "evaluation_seen": false,
    "evaluation_unseen_zero_shot": false,
    "adaptation": true,
    "evaluation_unseen_adaptation": false
  },
  "statistics": {"unit": "research_seed", "confidence": 0.95, "bootstrap_samples": 5000, "permutation_samples": 20000, "test": "paired_permutation", "multiple_comparisons": "holm"},
  "execution": {"workers": 1, "cuda_workers": 1, "device": "cpu", "allow_cpu_fallback": true},
  "human_study": {
    "merge_enabled": false,
    "dataset_version": "creativity-pilot-v1",
    "minimum_raters": 2
  },
  "suites": [
    {
      "kind": "creativity",
      "episodes": 20,
      "conditions": [
        {"name": "random"},
        {"name": "q_learning"},
        {"name": "dqn"},
        {"name": "novelty_search"},
        {"name": "aassr_no_novelty"},
        {"name": "aassr_no_imagination"},
        {"name": "full_aassr"}
      ]
    }
  ]
}
